<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow outgoing HTTP to localhost:5001 (Flask server) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow spawning python3 subprocess -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow read/write access to user-selected files (inbox, output) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow read access to Downloads folder (for finding .mp4 files) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
